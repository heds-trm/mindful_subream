{
    "inputs": {
        "image": "image",
        "label": "label"
    },
    "outputs": {
        "phase_0": "image",
		"phase_1": "image",
		"phase_2": "image",
		"phase_3": "image",
		"phase_4": "image",
		"phase_5": "image",
		"phase_6": "image",
		"phase_7": "image",
		"phase_8": "image",
		"phase_9": "image",
		"phase_10": "image",
		"phase_11": "image",
		"phase_12": "image",
        "label": "label"
    },
    "stages": {
        "preprocess": [
            {
                "modalities": ["image"],
                "type": "load_image_4d",
                "parameters": {
                    "image_only": true,
					"separate_channel_dim": false,
					"filename_pattern":"phase_*.mha"
                }
            },
            {
                "modalities": ["image"],
                "type": "scale_intensity",
                "parameters": {
                    "channel_wise": false
                }
            },
            {
                "modalities": ["image"],
                "type": "resize",
                "parameters": {
                    "spatial_size": [48, 48, 48]
                }
            },
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 0},
				"outputs": ["phase_0"]
			},
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 1},
				"outputs": ["phase_1"]
			},
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 2},
				"outputs": ["phase_2"]
			},
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 3},
				"outputs": ["phase_3"]
			},
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 4},
				"outputs": ["phase_4"]
			},
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 5},
				"outputs": ["phase_5"]
			},
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 6},
				"outputs": ["phase_6"]
			},
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 7},
				"outputs": ["phase_7"]
			},
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 8},
				"outputs": ["phase_8"]
			},
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 9},
				"outputs": ["phase_9"]
			},
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 10},
				"outputs": ["phase_10"]
			},
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 11},
				"outputs": ["phase_11"]
			},
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 12},
				"outputs": ["phase_12"]
			},
			{
				"modalities": ["phase_0", "phase_1", "phase_2", "phase_3", "phase_4", "phase_5", "phase_6", "phase_7", "phase_8", "phase_9", "phase_10", "phase_11", "phase_12"],
				"type": "ensure_channel_firstd",
				"parameters": {}
			},
            {
                "modalities": ["phase_0", "phase_1", "phase_2", "phase_3", "phase_4", "phase_5", "phase_6", "phase_7", "phase_8", "phase_9", "phase_10", "phase_11", "phase_12"],
                "type": "ensure_typed",
                "parameters": {
                    "device": "cpu",
                    "dtype": "float32"
				}
            },
            {
                "modalities": ["label"],
                "type": "to_tensor",
                "parameters": {
                    "dtype": "float32",
                    "device": "cpu"
                }
            }
        ],
        "view_augment": [
            {
                "modalities": ["phase_0", "phase_1", "phase_2", "phase_3", "phase_4", "phase_5", "phase_6", "phase_7", "phase_8", "phase_9", "phase_10", "phase_11", "phase_12"],
                "type": "rand_flipd",
                "parameters": {
                    "prob": 0.5
                }
            },
            {
                "modalities": ["phase_0", "phase_1", "phase_2", "phase_3", "phase_4", "phase_5", "phase_6", "phase_7", "phase_8", "phase_9", "phase_10", "phase_11", "phase_12"],
                "type": "rand_rotated",
                "parameters": {
                    "prob": 0.8,
                    "range_x": 0.34,
                    "range_y": 0.34,
                    "range_z": 0.34,
                    "padding_mode": "zeros"
                }
            },
            {
                "modalities": ["phase_0", "phase_1", "phase_2", "phase_3", "phase_4", "phase_5", "phase_6", "phase_7", "phase_8", "phase_9", "phase_10", "phase_11", "phase_12"],
                "type": "rand_affined",
                "parameters": {
                    "prob": 0.5,
                    "translate_range": [
                        2,
                        2,
                        2
                    ],
                    "padding_mode": "border"
                }
            },
            {
                "modalities": ["phase_0", "phase_1", "phase_2", "phase_3", "phase_4", "phase_5", "phase_6", "phase_7", "phase_8", "phase_9", "phase_10", "phase_11", "phase_12"],
                "type": "rand_gaussian_noised",
                "parameters": {
                    "prob": 0.2,
                    "std": 0.01
                }
            }
        ]
    }
}
