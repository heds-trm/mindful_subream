{
    "inputs": {
        "image": "image",
        "label": "label"
    },
    "outputs": {
		"phase_4": "image",
		"phase_8": "image",
        "label": "label"
    },
    "stages": {
        "preprocess": [
            {
                "modalities": ["image"],
                "type": "load_image_4d",
                "parameters": {
                    "image_only": true,
					"filter_slices": [4, 8],
					"separate_channel_dim": false,
					"filename_pattern":"phase_*.mha"
                }
            },
            {
                "modalities": ["image"],
                "type": "scale_intensity",
                "parameters": {
                    "channel_wise": false
                }
            },
            {
                "modalities": ["image"],
                "type": "resize",
                "parameters": {
                    "spatial_size": [48, 48, 48]
                }
            },
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 0},
				"outputs": ["phase_4"]
			},
			{
				"modalities": ["image"],
				"type": "take_slice",
				"parameters": {"axis": 0, "slice_index": 1},
				"outputs": ["phase_8"]
			},
			{
				"modalities": ["phase_4", "phase_8"],
				"type": "ensure_channel_firstd",
				"parameters": {}
			},
            {
                "modalities": ["phase_4", "phase_8"],
                "type": "ensure_typed",
                "parameters": {
                    "device": "cpu",
                    "dtype": "float32"
				}
            },
            {
                "modalities": ["label"],
                "type": "to_tensor",
                "parameters": {
                    "dtype": "float32",
                    "device": "cpu"
                }
            }
        ],
        "view_augment": [
            {
                "modalities": ["phase_4", "phase_8"],
                "type": "rand_flipd",
                "parameters": {
                    "prob": 0.5
                }
            },
            {
                "modalities": ["phase_4", "phase_8"],
                "type": "rand_rotated",
                "parameters": {
                    "prob": 0.8,
                    "range_x": 0.34,
                    "range_y": 0.34,
                    "range_z": 0.34,
                    "padding_mode": "zeros"
                }
            },
            {
                "modalities": ["phase_4", "phase_8"],
                "type": "rand_affined",
                "parameters": {
                    "prob": 0.5,
                    "translate_range": [
                        2,
                        2,
                        2
                    ],
                    "padding_mode": "border"
                }
            },
            {
                "modalities": ["phase_4", "phase_8"],
                "type": "rand_gaussian_noised",
                "parameters": {
                    "prob": 0.2,
                    "std": 0.01
                }
            }
        ]
    }
}
