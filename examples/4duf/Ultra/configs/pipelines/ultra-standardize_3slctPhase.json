{
    "inputs": {
        "image": "image",
        "label": "label"
    },
    "outputs": {
        "image": "image",
        "label": "label"
    },
    "stages": {
        "preprocess": [
            {
                "modalities": [
                    "image"
                ],
                "type": "load_image_4d",
                "parameters": {
					"filter_slices": [0, 6, 12],
                    "image_only": true
                }
            },
            {
                "modalities": [
                    "image"
                ],
                "type": "standardize_intensity",
                "parameters": {
                    "channel_wise": false,
                    "spatial_dims": 3
                }
            },
            {
                "modalities": [
                    "image"
                ],
                "type": "resize",
                "parameters": {
                    "spatial_size": [
                        8,
                        8,
                        8
                    ]
                }
            },
            {
                "modalities": [
                    "image"
                ],
                "type": "ensure_type",
                "parameters": {
                    "device": "cpu",
                    "dtype": "float32"
                }
            },
            {
                "modalities": [
                    "label"
                ],
                "type": "to_tensor",
                "parameters": {
                    "dtype": "float32",
                    "device": "cpu"
                }
            }
        ],
        "view_augment": [
            {
                "modalities": [
                    "image"
                ],
                "type": "rand_flip",
                "parameters": {
                    "prob": 0.5
                }
            },
            {
                "modalities": [
                    "image"
                ],
                "type": "rand_rotate",
                "parameters": {
                    "prob": 0.8,
                    "range_x": 0.34,
                    "range_y": 0.34,
                    "range_z": 0.34,
                    "padding_mode": "zeros"
                }
            },
            {
                "modalities": [
                    "image"
                ],
                "type": "rand_affine",
                "parameters": {
                    "prob": 0.5,
                    "translate_range": [
                        2,
                        2,
                        2
                    ],
                    "padding_mode": "border"
                }
            },
            {
                "modalities": [
                    "image"
                ],
                "type": "rand_gaussian_noise",
                "parameters": {
                    "prob": 0.2,
                    "std": 0.01
                }
            }
		]
    }
}